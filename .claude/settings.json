{
  "permissions": {
    "allow": [
      "Bash(./mvnw *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git stash *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr status *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue comment *)",
      "Bash(gh pr comment *)",
      "Bash(gh project view *)",
      "Bash(gh project list *)",
      "Bash(gh project field-list *)",
      "Bash(gh project item-list *)",
      "Bash(gh project item-add *)",
      "Bash(gh project item-edit *)",
      "Bash(gh api -X PATCH repos/FabianoNR/pode-gastar/issues/*)",
      "Bash(gh api repos/FabianoNR/pode-gastar/issues/* --jq .type.name)",
      "Bash(diff *)",
      "Bash(gh repo view *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/credentials*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/credentials*)",
      "Write(.env)",
      "Write(.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(**/credentials*)",
      "Bash(git restore *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git stash drop *)",
      "Bash(git stash clear *)",
      "Bash(git stash drop)",
      "Bash(git stash clear)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(git push * refs/heads/main)",
      "Bash(git push * +main)",
      "Bash(git push *:main)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Bash(gh project delete *)",
      "Bash(gh project item-delete *)",
      "Bash(gh project field-delete *)",
      "Bash(gh project close *)",
      "Bash(gh issue delete *)",
      "Bash(gh issue transfer *)",
      "Bash(gh api *merge*)",
      "Bash(gh api -X DELETE *)",
      "Bash(gh api --method DELETE *)",
      "Bash(gh api graphql *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && { [ -f ./mvnw ] || exit 0; ./mvnw -q spotless:apply; }"
          }
        ]
      }
    ]
  }
}
